  },
  "rang.marskal_info": {
    "file": "ffc2b9846ae6dbf0.mp3",
    "text": "Marskallen er den stærkeste soldat. Men pas på spionen!",
    "speaker": "fortaeller"
  },
  "rang.general_info": {
    "file": "2db60c8cea5d614e.mp3",
    "text": "Generalen er næsten lige så stærk som marskallen.",
    "speaker": "fortaeller"
  },
  "rang.oberst_info": {
    "file": "9b2899c6aa7b6b4e.mp3",
    "text": "Obersten er en stærk soldat.",
    "speaker": "fortaeller"
  },
  "rang.major_info": {
    "file": "7239e174f7dd4a41.mp3",
    "text": "Majoren er god til at slå de svagere soldater.",
    "speaker": "fortaeller"
  },
  "rang.kaptajn_info": {
    "file": "44ca14b4dc55fc55.mp3",
    "text": "Kaptajnen er en solid soldat midt i hæren.",
    "speaker": "fortaeller"
  },
  "rang.loejtnant_info": {
    "file": "984e53bb88fdcd3b.mp3",
    "text": "Løjtnanten er modig og hurtig på aftrækkeren.",
    "speaker": "fortaeller"
  },
  "rang.sergent_info": {
    "file": "47f62b19e0ee3b71.mp3",
    "text": "Sergenten holder sammen på tropperne.",
    "speaker": "fortaeller"
  },
  "rang.minoer_info": {
    "file": "ef4263b4c661ba34.mp3",
    "text": "Minøren er den eneste, der kan desarmere miner.",
    "speaker": "fortaeller"
  },
  "rang.spejder_info": {
    "file": "d2888db0b7664339.mp3",
    "text": "Spejderen kan løbe mange felter på én gang.",
    "speaker": "fortaeller"
  },
  "rang.spion_info": {
    "file": "1a6601345598c103.mp3",
    "text": "Spionen er svag – men han kan slå marskallen, hvis han angriber først.",
    "speaker": "fortaeller"
  },
  "rang.mine_info": {
    "file": "c613ef8364eb71c0.mp3",
    "text": "Minen kan ikke flytte sig. Den, der går på den, falder – undtagen minøren.",
    "speaker": "fortaeller"
  },
  "rang.flag_info": {
    "file": "0607cf25389cbc55.mp3",
    "text": "Pas godt på flaget! Hvis fjenden tager det, har I tabt.",
    "speaker": "fortaeller"
  },
  "slut.groen_vinder": {
    "file": "51110925cde91504.mp3",
    "text": "Den grønne hær vinder!",
    "speaker": "groen"
  },
  "slut.sand_vinder": {
    "file": "179970953a0c5f3a.mp3",
