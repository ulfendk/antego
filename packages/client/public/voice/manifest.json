  "tutorial.velkommen": {
    "file": "ae9b3f6e9cd496df.mp3",
    "text": "Velkommen, soldat! Jeg er sergenten, og jeg viser dig, hvordan man spiller.",
    "speaker": "sergent"
  },
  "tutorial.maal": {
    "file": "22b51bbb2ddb20b7.mp3",
    "text": "Målet er at finde og erobre fjendens flag – før fjenden tager dit.",
    "speaker": "sergent"
  },
  "tutorial.dine": {
    "file": "b116489fbc3a6b18.mp3",
    "text": "Dine soldater er grønne. Tallet over dem viser, hvor stærke de er. Jo højere tal, jo stærkere.",
    "speaker": "sergent"
  },
  "tutorial.fjender": {
    "file": "aa52bf71898ea911.mp3",
    "text": "Fjendens soldater står bag plastikskjolde. Du ved ikke, hvem de er, før I kæmper.",
    "speaker": "sergent"
  },
  "tutorial.flyt": {
    "file": "c25bdb50e5ec7b72.mp3",
    "text": "Tryk på din kaptajn med sekstallet – og tryk så på det lysende felt foran ham.",
    "speaker": "sergent"
  },
  "tutorial.flot_flyt": {
    "file": "f1e3054f784f96bc.mp3",
    "text": "Flot! Soldater går ét felt ad gangen – frem, tilbage eller til siden. Aldrig på skrå.",
    "speaker": "sergent"
  },
  "tutorial.soeer": {
    "file": "f8e5d142f5a2061a.mp3",
    "text": "Ingen kan gå ud i søerne. Man må gå udenom!",
    "speaker": "sergent"
  },
  "tutorial.spejder": {
    "file": "cb837392c61f50d7.mp3",
    "text": "Spejderen med totallet er speciel. Han kan løbe mange felter på én gang i en lige linje.",
    "speaker": "sergent"
  },
  "tutorial.angrib": {
    "file": "978f81aa08fabf12.mp3",
    "text": "Nu skal vi kæmpe! Tryk på kaptajnen, og tryk så på fjendens skjold lige foran ham.",
    "speaker": "sergent"
  },
  "tutorial.kamp_forklaring": {
    "file": "964f6f93fbe284c7.mp3",
    "text": "Når to soldater mødes, vinder den stærkeste. Er de lige stærke, dyster de i et minispil om, hvem der vinder!",
    "speaker": "sergent"
  },
  "tutorial.miner": {
    "file": "76fdf826d1fbe15b.mp3",
    "text": "Pas på minerne! Den, der går på en mine, falder. Kun minøren kan desarmere den.",
    "speaker": "sergent"
  },
  "tutorial.spion": {
    "file": "14e0443830a45a11.mp3",
    "text": "Spionen er den svageste soldat. Men hvis han angriber marskallen, vinder spionen!",
    "speaker": "sergent"
  },
  "tutorial.flag": {
    "file": "b1607404cec53e17.mp3",
    "text": "Fjendens flag står lige derfremme. Gå frem med kaptajnen, og erobr det!",
    "speaker": "sergent"
  },
  "tutorial.godt": {
    "file": "93936ffc2862b22c.mp3",
    "text": "Godt klaret, soldat! Nu er du klar til din første rigtige kamp.",
    "speaker": "sergent"
  },
  "tutorial.igen": {
    "file": "14501a3065128743.mp3",
    "text": "Hov, det gik ikke helt efter planen. Lad os prøve igen!",
    "speaker": "sergent"
  },
  "tutorial.videre": {
    "file": "f0cd32b84264cf85.mp3",
    "text": "Videre",
    "speaker": "fortaeller"
  },
  "tutorial.spring_over": {
    "file": "0382d16b22297916.mp3",
    "text": "Spring over",
    "speaker": "fortaeller"
  },
  "tutorial.proev_igen": {
    "file": "74fc2a85bd083b3e.mp3",
    "text": "Prøv igen",
    "speaker": "fortaeller"
  }
}
