  },
  "race.titel": {
    "file": "eb279ecd4c3a2f54.mp3",
    "text": "Jeepræs!",
    "speaker": "sergent"
  },
  "race.hjaelp": {
    "file": "bebd991deea510fe.mp3",
    "text": "Sæt tommelfingeren på skærmen og skub den derhen, hvor jeepen skal køre. Følg tapen tre gange rundt om brættet – og pas på søerne!",
    "speaker": "fortaeller"
  },
  "race.sidste_omgang": {
    "file": "c3045c8911a3bd0a.mp3",
    "text": "Sidste omgang!",
    "speaker": "sergent"
  },
  "race.forkert_vej": {
    "file": "894100bb43c0d12d.mp3",
    "text": "Forkert vej, soldat! Vend om!",
    "speaker": "sergent"
  },
  "race.nummer_1": {
    "file": "3849d854b2d28a38.mp3",
    "text": "Du vandt! Du er den hurtigste på hele bordet.",
    "speaker": "fortaeller"
  },
  "race.nummer_2": {
    "file": "983d1fa614afb03f.mp3",
    "text": "Du blev nummer to. Flot kørt!",
    "speaker": "fortaeller"
  },
  "race.nummer_3": {
    "file": "492d87e6df6c6816.mp3",
    "text": "Du blev nummer tre. Godt kæmpet!",
    "speaker": "fortaeller"
  },
  "race.nummer_4": {
    "file": "24982c14ca112a8b.mp3",
    "text": "Du blev nummer fire. Prøv igen – du kan godt!",
    "speaker": "fortaeller"
  },
  "race.igen": {
    "file": "6c57f2c6905ed365.mp3",
    "text": "Kør igen",
    "speaker": "fortaeller"
  },
