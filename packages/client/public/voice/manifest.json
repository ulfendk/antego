  "minispil.faldskaerm": {
    "file": "d80d249ce01bd3ad.mp3",
    "text": "Faldskærm!",
    "speaker": "sergent"
  },
  "minispil.faldskaerm_hjaelp": {
    "file": "d63ed1a7965762f9.mp3",
    "text": "Træk fingeren til siden og styr faldskærmssoldaten ned på målet.",
    "speaker": "fortaeller"
  },
  "minispil.korkskud": {
    "file": "d85346998056d18a.mp3",
    "text": "Korkskud!",
    "speaker": "sergent"
  },
  "minispil.korkskud_hjaelp": {
    "file": "c5a2913dd81b5126.mp3",
    "text": "Tryk på skiverne, så hurtigt du kan – før de forsvinder igen.",
    "speaker": "fortaeller"
  },
  "minispil.stormloeb": {
    "file": "4ce1693222722682.mp3",
    "text": "Stormløb!",
    "speaker": "sergent"
  },
  "minispil.stormloeb_hjaelp": {
    "file": "35673e501fb6ae10.mp3",
    "text": "Tryk og tryk og tryk! Jo hurtigere du trykker, jo længere løber soldaten.",
    "speaker": "fortaeller"
  },
  "minispil.spiller_groen": {
    "file": "f1a281757c69bc03.mp3",
    "text": "Den grønne hær kæmper nu.",
    "speaker": "groen"
  },
  "minispil.spiller_sand": {
    "file": "a6e8d86e97145bc5.mp3",
    "text": "Den sandfarvede hær kæmper nu.",
    "speaker": "sand"
  },
  "minispil.spiller_blaa": {
    "file": "9460acd9a4226b90.mp3",
