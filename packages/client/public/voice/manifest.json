  "slut.blaa_vinder": {
    "file": "c6cba73ca981da7b.mp3",
    "text": "Den gråblå hær vinder!",
    "speaker": "blaa"
  },
  "slut.brun_vinder": {
    "file": "b953f680623252ae.mp3",
    "text": "Den brune hær vinder!",
    "speaker": "brun"
  },
  "slut.hold_groen": {
    "file": "f88b9c1be53cb628.mp3",
    "text": "Den grønne og den sandfarvede hær vinder sammen!",
    "speaker": "sergent"
  },
  "slut.hold_blaa": {
    "file": "8185be1e1a7b0b07.mp3",
    "text": "Den gråblå og den brune hær vinder sammen!",
    "speaker": "sergent"
  },
  "slut.du_vandt": {
    "file": "720f9c0294be8cb3.mp3",
    "text": "Du vandt! Godt kæmpet, soldat!",
    "speaker": "sergent"
  },
  "slut.du_tabte": {
    "file": "f2e3eb97da974490.mp3",
    "text": "Computeren vandt denne gang. Prøv igen!",
    "speaker": "sergent"
  },
  "slut.ingen_traek": {
    "file": "2b8095bb96541fc0.mp3",
    "text": "Modstanderen kunne ikke flytte flere soldater.",
    "speaker": "fortaeller"
  },
  "slut.opgivet": {
    "file": "84e27e0e97de8d48.mp3",
    "text": "Modstanderen gav op.",
    "speaker": "fortaeller"
  },
  "slut.igen": {
    "file": "0af08a47f541ba12.mp3",
    "text": "Spil igen",
    "speaker": "fortaeller"
  },
  "slut.menu": {
    "file": "7c1bf6d7c4267707.mp3",
    "text": "Til menuen",
    "speaker": "fortaeller"
  },
  "slut.modstander_vandt": {
    "file": "3397092b488b3ad9.mp3",
    "text": "Modstanderen vandt denne gang. Godt kæmpet!",
    "speaker": "sergent"
  },
  "spil.tur_groen": {
    "file": "fe9c9a59bf468ae4.mp3",
    "text": "Grøn hær – det er jeres tur!",
    "speaker": "groen"
  },
  "spil.tur_sand": {
    "file": "832db4ff7ec35ea0.mp3",
    "text": "Sandfarvet hær – det er jeres tur!",
    "speaker": "sand"
  },
  "spil.tur_blaa": {
    "file": "d03d4d8e05fb1df5.mp3",
    "text": "Gråblå hær – det er jeres tur!",
    "speaker": "blaa"
  },
  "spil.tur_brun": {
    "file": "0ac2bc6e35252f8c.mp3",
    "text": "Brun hær – det er jeres tur!",
    "speaker": "brun"
  },
  "spil.din_tur": {
    "file": "baac75d1bbc7e8e4.mp3",
    "text": "Din tur, soldat!",
    "speaker": "sergent"
  },
  "spil.computer_tur": {
    "file": "0180bc404af1e097.mp3",
    "text": "Computeren tænker…",
    "speaker": "fortaeller"
  },
  "spil.giv_groen": {
    "file": "fd3f40748ee56f28.mp3",
    "text": "Giv skærmen til den grønne hær. Ingen kigger!",
    "speaker": "fortaeller"
  },
  "spil.giv_sand": {
    "file": "0f821429b1a2702a.mp3",
    "text": "Giv skærmen til den sandfarvede hær. Ingen kigger!",
    "speaker": "fortaeller"
  },
  "spil.giv_blaa": {
    "file": "99659b2e3b6a756f.mp3",
    "text": "Giv skærmen til den gråblå hær. Ingen kigger!",
    "speaker": "fortaeller"
  },
  "spil.giv_brun": {
    "file": "140df642483ceb69.mp3",
    "text": "Giv skærmen til den brune hær. Ingen kigger!",
    "speaker": "fortaeller"
  },
  "spil.jeg_er_klar": {
    "file": "a47f00ae00cd6e0e.mp3",
    "text": "Jeg er klar",
    "speaker": "fortaeller"
  },
  "spil.vaelg_soldat": {
    "file": "c9b1334b80130ff9.mp3",
    "text": "Tryk på en af dine soldater.",
    "speaker": "fortaeller"
  },
  "spil.kan_ikke_flytte": {
    "file": "dc835ba6c22364a9.mp3",
    "text": "Den soldat kan ikke flytte sig.",
    "speaker": "fortaeller"
  },
  "spil.opgiv": {
    "file": "44cdd5d48d7f0c3a.mp3",
    "text": "Giv op",
    "speaker": "fortaeller"
  },
  "spil.menu": {
    "file": "64db965553adabed.mp3",
    "text": "Menu",
    "speaker": "fortaeller"
  },
  "spil.fortsaet": {
    "file": "23b98c2b8cd9ab00.mp3",
    "text": "Fortsæt",
    "speaker": "fortaeller"
  },
  "spil.centrer": {
    "file": "90fcf18394526a49.mp3",
    "text": "Vis hele brættet",
    "speaker": "fortaeller"
  },
  "spil.ude_groen": {
    "file": "b241ef28fd138ebe.mp3",
    "text": "Den grønne hær er ude!",
    "speaker": "sergent"
  },
  "spil.ude_sand": {
    "file": "a48218b52fc5d169.mp3",
    "text": "Den sandfarvede hær er ude!",
    "speaker": "sergent"
  },
  "spil.ude_blaa": {
    "file": "5dbaf69514aea7d5.mp3",
    "text": "Den gråblå hær er ude!",
    "speaker": "sergent"
  },
  "spil.ude_brun": {
    "file": "f7b854e66a1147dc.mp3",
    "text": "Den brune hær er ude!",
    "speaker": "sergent"
  },
  "spil.du_er_ude": {
    "file": "015b63fe73537435.mp3",
    "text": "Din hær er ude! Vil du se med og finde ud af, hvem der vinder?",
    "speaker": "sergent"
  },
  "spil.makker": {
    "file": "8211a6e6020373d0.mp3",
    "text": "Din makker er den sandfarvede hær. I kan se hinandens soldater!",
    "speaker": "sergent"
  },
  "spil.se_med": {
    "file": "983a1fe77cce57d6.mp3",
    "text": "Se med",
    "speaker": "fortaeller"
  },
