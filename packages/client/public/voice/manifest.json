    "speaker": "fortaeller"
  },
  "online.din_kode": {
    "file": "256e8462730c7576.mp3",
    "text": "Jeres kode er",
    "speaker": "fortaeller"
  },
  "online.vis_kode": {
    "file": "13581b7f49437dab.mp3",
    "text": "Sig koden til din ven – eller lad dem scanne den.",
    "speaker": "fortaeller"
  },
  "online.venter": {
    "file": "663af805b4a08e27.mp3",
    "text": "Venter på en modstander …",
    "speaker": "fortaeller"
  },
  "online.skriv_kode": {
    "file": "31c508cf8a212a25.mp3",
    "text": "Skriv koden fra din ven.",
    "speaker": "fortaeller"
  },
  "online.slet": {
    "file": "8d99e3a1397ee0d7.mp3",
    "text": "Slet",
    "speaker": "fortaeller"
  },
  "online.forbind": {
    "file": "d5dec36c06fc8fe1.mp3",
    "text": "Forbind",
    "speaker": "fortaeller"
  },
  "online.forbinder": {
    "file": "2f3646a01507d854.mp3",
    "text": "Forbinder …",
    "speaker": "fortaeller"
  },
  "online.ukendt_kode": {
    "file": "a477b29c1a290f7b.mp3",
    "text": "Den kode findes ikke. Prøv igen.",
    "speaker": "fortaeller"
  },
  "online.fuld": {
    "file": "04f277d85aa83c6e.mp3",
    "text": "Det spil er allerede fyldt.",
    "speaker": "fortaeller"
  },
  "online.ingen_net": {
    "file": "417347fc58629240.mp3",
    "text": "Der er ingen forbindelse. Prøv igen om lidt.",
    "speaker": "fortaeller"
  },
  "online.forsinket": {
    "file": "33cbe173b17a4a36.mp3",
    "text": "Spillet bliver opdateret. Prøv igen om et øjeblik.",
    "speaker": "fortaeller"
  },
  "online.du_er_groen": {
    "file": "d819d1c53be6169b.mp3",
    "text": "Du fører den grønne hær.",
    "speaker": "groen"
  },
  "online.du_er_sand": {
    "file": "955cb725d3126746.mp3",
    "text": "Du fører den sandfarvede hær.",
    "speaker": "sand"
  },
  "online.du_er_blaa": {
    "file": "f1b112f8c1668878.mp3",
    "text": "Du fører den gråblå hær.",
    "speaker": "blaa"
  },
  "online.du_er_brun": {
    "file": "6f40f8b4460cb16c.mp3",
    "text": "Du fører den brune hær.",
    "speaker": "brun"
  },
  "online.venter_opstilling": {
    "file": "457c8c70fb2c5d91.mp3",
    "text": "Venter på, at modstanderen stiller op …",
    "speaker": "fortaeller"
  },
  "online.modstander_tur": {
    "file": "c3983c5f304f3f52.mp3",
    "text": "Modstanderen tænker …",
    "speaker": "fortaeller"
  },
  "online.modstander_vaek": {
    "file": "002416b9ad8a9bbc.mp3",
    "text": "Modstanderen har mistet forbindelsen. Vi venter lidt …",
    "speaker": "fortaeller"
  },
  "online.modstander_tilbage": {
    "file": "14b7088314965044.mp3",
    "text": "Modstanderen er tilbage!",
    "speaker": "fortaeller"
  },
  "online.mistet": {
    "file": "c9e3e88845b09fd7.mp3",
    "text": "Forbindelsen blev afbrudt. Vi prøver igen …",
    "speaker": "fortaeller"
  },
  "online.tilbage": {
    "file": "34e3f52ffce90608.mp3",
    "text": "Forbindelsen er tilbage!",
    "speaker": "fortaeller"
  },
  "opstilling.titel": {
    "file": "556b8a17ad1eda19.mp3",
    "text": "Stil dine soldater op!",
    "speaker": "sergent"
  },
  "opstilling.hjaelp": {
    "file": "d66e9ac1ca0fad32.mp3",
    "text": "Vælg en opstilling – eller tryk på to soldater for at bytte dem.",
    "speaker": "fortaeller"
  },
